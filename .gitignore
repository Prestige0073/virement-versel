# Environnement
.env
.env.local
.env.*.local
.env.production

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Vite
.vite/
.cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.iml

# Tests
coverage/
.nyc_output/

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# Credentials
*.pem
*.key
.credentials

# Supabase local
supabase/seed_*.sql
.supabase/

# Production
.vercel/
.output/

# Misc
.cache-loader
.eslintcache
